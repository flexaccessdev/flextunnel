# flextunnel client config (TOML).
#
# Load with:  flextunnel client start -c client.toml
#         or: place it at ~/.config/flextunnel/client.toml, where it is loaded
#             automatically when `client start` is run with any other flag
#             (e.g. `flextunnel client start --socks-port 1080`). A bare
#             `client start` with no arguments prints help; `--quick` ignores
#             this file entirely — it prompts for the connection details and
#             runs a self-contained live panel in the terminal (no config, no
#             lock, no control socket; quitting disconnects).
#
# One client reaches any number of servers. Each `[[destinations]]` table below
# gives a server a name; the client connects to a server only when
# something is actually sent to it, and closes the connection again once it
# has been unused for a while.
#
# CLI flags override the top-level values. Unknown keys are rejected.

# Optional name of this client instance. It keys the single-instance lock and
# the control socket, so `flextunnel client control` and `flextunnel client nc`
# find the running client from this config (or with `-n <name>`), and two
# clients can run side by side under different names. Lowercase letters,
# digits, `-` and `_`. Default: "default".
# name = "work"

# Optional local SOCKS5 listener port. Unset means disabled. Listeners bind
# 127.0.0.1 only (they are unauthenticated, so they are never exposed beyond
# this machine — same as the desktop client).
# socks_port = 1080

# Optional HTTP proxy listener port (CONNECT + absolute-URI plain-HTTP
# forwarding). Unset means disabled. With neither socks_port nor http_port
# set, the client runs in port-forward-only mode (see [[forwards]] below);
# `flextunnel client nc` works either way.
# http_port = 8081

# This client's authentication keypair — always a key file (generate with
# `flexaccess-keys generate-auth-key -o ~/.config/flextunnel/client.key`;
# put its public entry, from `flexaccess-keys show-auth-key
# --private-key-file ~/.config/flextunnel/client.key`, on each server's
# authorized_keys_file). Used for every destination that does not name its
# own. There is no inline variant in the config; `--auth-key` exists only as a
# CLI flag.
auth_key_file = "~/.config/flextunnel/client.key"

# Optional iroh tuning.
# Custom relays (two or more for failover), used for every destination that
# does not name its own. Configuring custom relays disables n0 internet
# discovery (pkarr/DNS) — a server is reached via relay hints instead; mDNS
# local-network discovery stays on. relay_auth_token is an optional shared
# bearer token sent to every custom relay's WebSocket upgrade; it is only
# valid with custom relay_urls (rejected with the default iroh relays).
# relay_urls = ["https://relay-a.example", "https://relay-b.example"]
# relay_auth_token = "shared-relay-secret"

# How long a destination's connection is kept with nothing using it, in
# seconds. Default: 300, at most 31536000 (one year). `0` never closes an idle
# connection (it is still only opened on first use). A connection with an open stream — an ssh session, a
# download — is never idle, however long it lasts. The first use after an idle
# close pays for a fresh connection; raise this if that delay is noticeable
# (most likely with custom relays while one of them is down).
# idle_timeout_secs = 300

# A destination: a name for one server.
#
#   name            One DNS label, unique within this client: letters, digits
#                   and inner hyphens, up to 63 (case-insensitive; no dots).
#                   `<name>.localhost.flextunnel.internal:<port>` through this
#                   client — the SOCKS5 or HTTP proxy, a [[forwards]] entry,
#                   `flextunnel client nc` — reaches that port on the
#                   *server's own loopback*, with no server-side routing
#                   config. The name alone is not a host: everything the client
#                   answers by itself stays under `flextunnel.internal`.
#   server_node_id  The server's EndpointId (from `flextunnel show-iroh-id`).
#   routed_domains  Optional further names sent through this server: an exact
#                   name, a `*.suffix` wildcard (subdomains only), or `*` for
#                   every hostname. Names only — an IP address goes under
#                   routed_cidrs. Resolved on the server (its host aliases
#                   apply).
#   routed_cidrs    Optional further networks or bare IPs sent through this
#                   server. `*` never covers IP literals; pair it with
#                   "0.0.0.0/0" (and "::/0") for a full tunnel.
#
# The server enforces its own routed_domains / routed_cidrs (see
# server.toml.example) as an allowlist, so list a route here only if the
# server lists it too — otherwise the server answers "connection not allowed".
# Neither side applies the other's lists; the server's can be read at
# http://flextunnel.internal/servers/<name>/status.json — a URL that only
# this client's own proxy answers, so it needs socks_port or http_port set
# above and a request made through that listener, e.g.
#   curl -sS -x socks5h://127.0.0.1:1080 'http://flextunnel.internal/servers/<name>/status.json'
#
# When destinations overlap, the most specific rule wins: an exact domain,
# then the longest `*.suffix`, then `*`; for IPs the longest prefix. The same rule on two destinations is an error. Anything
# on no destination's list is connected directly from this machine.
[[destinations]]
name = "machine1"
server_node_id = "<server endpoint id>"
# routed_domains = ["*.corp.example", "db.internal"]
# routed_cidrs = ["10.0.0.0/8"]

# A destination may override the client key and the relays above. One that
# names its own relay_urls uses only its own relay_auth_token.
# [[destinations]]
# name = "machine2"
# server_node_id = "<another server endpoint id>"
# auth_key_file = "~/.config/flextunnel/machine2.key"
# relay_urls = ["https://relay-c.example", "https://relay-d.example"]
# relay_auth_token = "machine2-relay-secret"

# Port forwards: each `[[forwards]]` table listens on localhost:<local_port>
# (127.0.0.1/::1 only) and opens a stream to <remote_host>:<remote_port>
# through the destination that routes remote_host — connecting to that server
# on the first forwarded connection. remote_host is routed exactly like a proxy
# request, except that a host no destination routes is a startup error: a
# forward never connects directly. Forwards are declared here only — the
# control panel (`flextunnel client control`) shows their state but cannot
# change them; edit this file and restart the client instead. A forward whose
# local port cannot bind is switched off with the reason shown next to its
# row. Local ports must be unique and nonzero. label is optional (display
# only).
#
# Use a destination's <name>.localhost.flextunnel.internal to reach the
# server's loopback without any server-side route.
# [[forwards]]
# label = "local-web"
# local_port = 8080
# remote_host = "machine1.localhost.flextunnel.internal"   # port 80 on machine1 itself
# remote_port = 80
#
# [[forwards]]
# label = "db"
# local_port = 5432
# remote_host = "db.internal"         # needs a route above, and on the server
# remote_port = 5432
#
# [[forwards]]
# local_port = 8443
# remote_host = "10.0.0.7"
# remote_port = 443
